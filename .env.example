# Copy to .env for local runs. NEVER commit .env or your real salt.
# Per-team HMAC salt printed on the team slip (spec 1.2). The grader sets it on the command line.
DAY1_SALT=replace-with-your-team-salt
# Part II: 16-character salt from the Day 2 venue slip (HMAC key for all Phase II signatures).
DAY2_SALT=replace-with-your-day2-salt
# Database (defaults shown; the database is only reachable inside the compose network).
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon_local_dev
POSTGRES_DB=nascon
# Optional JWT signing secret. If empty, a key is derived from DAY1_SALT.
JWT_SECRET=
